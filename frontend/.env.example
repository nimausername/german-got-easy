# Optional. Copy to `.env.local` only if the API is not on http://localhost:4000.
# The browser always calls same-origin `/v1`. Next.js proxies that to the API.

NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_PRODUCT_NAME="German Got Easy"

# Optional — only needed when installing premium ReUI blocks/icons via shadcn CLI.
# REUI_LICENSE_KEY=
