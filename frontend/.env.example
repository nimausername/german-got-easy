# German Got Easy frontend — copy to `.env.local` and fill values.
# Never commit real secrets. Only NEXT_PUBLIC_* values are exposed to the browser.

NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_PRODUCT_NAME="German Got Easy"

# Optional Coolify runtime override (container env, not baked into the client bundle).
# API_URL=https://api.example.com

# Optional — only needed when installing premium ReUI blocks/icons via shadcn CLI.
# REUI_LICENSE_KEY=
