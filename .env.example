# German Got Easy — copy to `.env` and fill values. Never commit real secrets.
# Full guides: docs/README.md

PRODUCT_NAME="German Got Easy"

# --- Required: services you host ---
# PostgreSQL
DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DATABASE

# Keycloak (this app does not start Keycloak). See docs/keycloak.md
# KEYCLOAK_URL must match the hostname on issued JWTs.
KEYCLOAK_URL=https://auth.example.com
KEYCLOAK_REALM=german
KEYCLOAK_BACKEND_CLIENT_ID=german-backend
KEYCLOAK_BACKEND_CLIENT_SECRET=change-me
# Optional in-network origin when the API cannot reach KEYCLOAK_URL (same-server Coolify).
# KEYCLOAK_INTERNAL_URL=http://keycloak:8080

# --- Required: web origin the browser uses (no trailing slash) ---
CORS_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# --- Local API ---
PORT=4000
HOST=0.0.0.0

# --- Local web (optional) ---
# `pnpm --dir frontend dev` proxies /v1 to localhost:4000 when this is unset.
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_PRODUCT_NAME="German Got Easy"

# --- Production / Coolify extras ---
# CORS_ORIGIN=https://app.example.com
# COOKIE_SECURE=true
# RUN_SEED=true
# KEYCLOAK_BOOTSTRAP=false
# KEYCLOAK_ADMIN_USERNAME=admin
# KEYCLOAK_ADMIN_PASSWORD=

# --- Word drip (optional) ---
# Unlock this many queued words per UTC day (default 20).
# WORD_DAILY_RELEASE_LIMIT=20
# Set false to disable hourly catch-up inside the API process.
# WORD_RELEASE_CRON_ENABLED=true

# Optional local test user (dev only)
# TEST_USER_EMAIL=learner1@mail.com
# TEST_USER_USERNAME=learner1
# TEST_USER_PASSWORD=

# --- Lesson audio CDN (Cloudflare R2) ---
# Required in production. Local: set this after uploading MP3s with audio:upload-r2.
# AUDIO_PUBLIC_BASE_URL=https://germanaudio.example.com
#
# Upload credentials for: pnpm --dir backend audio:upload-r2
# (MP3s are generated locally, uploaded to R2, and gitignored.)
# Use the EU endpoint when the bucket jurisdiction is European Union.
# R2_BUCKET=german-got-easy-audio
# R2_ENDPOINT=https://<ACCOUNT_ID>.eu.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
