# German Got Easy — copy to `.env` and fill values. Never commit real secrets.

PRODUCT_NAME="German Got Easy"

# Database (PostgreSQL you host)
DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DATABASE

# Keycloak — you host this. The app does not start Keycloak.
# Public origin used as the JWT issuer. Must match the hostname tokens use.
KEYCLOAK_URL=https://auth.example.com
# Optional in-network origin for token/admin calls (same-server Coolify hairpin).
# KEYCLOAK_INTERNAL_URL=http://keycloak:8080
KEYCLOAK_REALM=german
KEYCLOAK_BACKEND_CLIENT_ID=german-backend
KEYCLOAK_BACKEND_CLIENT_SECRET=change-me

# API
PORT=4000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
# Use "none" only with COOKIE_SECURE=true (cross-site frontends).
COOKIE_SAME_SITE=lax

# Frontend (public)
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_PRODUCT_NAME="German Got Easy"
# Coolify / production — public origins the browser uses
# CORS_ORIGIN=https://app.example.com
# API_URL=https://api.example.com

# Optional local test user (dev only)
# TEST_USER_EMAIL=learner1@mail.com
# TEST_USER_USERNAME=learner1
# TEST_USER_PASSWORD=

# Production / Coolify only — backend entrypoint
# RUN_SEED=true
# Optional: create realm/client on an already running Keycloak (needs admin vars).
# KEYCLOAK_BOOTSTRAP=false
# KEYCLOAK_ADMIN_USERNAME=admin
# KEYCLOAK_ADMIN_PASSWORD=
