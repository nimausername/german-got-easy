# German Got Easy — copy to `.env` and fill values. Never commit real secrets.

PRODUCT_NAME="German Got Easy"

# Database (PostgreSQL)
DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DATABASE

# Keycloak (Option 1 — in-app auth via backend)
KEYCLOAK_URL=https://auth.example.com
KEYCLOAK_REALM=german
KEYCLOAK_BACKEND_CLIENT_ID=german-backend
KEYCLOAK_BACKEND_CLIENT_SECRET=change-me

# API
PORT=4000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
# Use "none" only with COOKIE_SECURE=true (cross-site frontends).
COOKIE_SAME_SITE=lax

# Frontend (public)
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_PRODUCT_NAME="German Got Easy"

# Optional local test user (dev only)
# TEST_USER_EMAIL=learner1@mail.com
# TEST_USER_USERNAME=learner1
# TEST_USER_PASSWORD=
