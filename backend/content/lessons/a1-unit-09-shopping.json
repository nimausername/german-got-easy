      {
        "slug": "prices",
        "title": "Was kostet das?",
        "canDo": "I can ask how much something costs and understand euro prices.",
        "summary": "Was kostet das? / Das kostet … Euro.",
        "skillTags": ["phrases", "listening", "vocabulary"],
        "teachBlocks": [
          {
            "type": "explain",
            "title": "Ask the price",
            "body": "Ask Was kostet das? (What does that cost?). Answer: Das kostet acht Euro. or Es kostet zwei Euro fünfzig. Euro stays Euro in the plural in prices.",
            "examples": [
              { "de": "Was kostet das?", "en": "What does that cost?" },
              { "de": "Das kostet zehn Euro.", "en": "That costs ten euros." }
            ]
          },
          {
            "type": "listen_model",
            "title": "Listen",
            "text": "Das kostet fünf Euro.",
            "hint": "Hear kostet and Euro."
          },
          {
            "type": "pattern",
            "title": "Price pattern",
            "template": "Das kostet ____ Euro.",
            "meaning": "That costs ____ euros.",
            "examples": ["Das kostet drei Euro.", "Das kostet zwanzig Euro."]
          }
        ],
        "exercises": [
          {
            "type": "cloze",
            "prompt": "Was _____ das?",
            "payload": { "answer": "kostet", "accepted": ["kostet"] }
          },
          {
            "type": "listen_mcq",
            "prompt": "Listen. How much?",
            "payload": {
              "speakText": "Das kostet zwölf Euro.",
              "options": ["2 Euro", "10 Euro", "12 Euro", "20 Euro"],
              "answer": "12 Euro"
            }
          },
          {
            "type": "short_write",
            "prompt": "Write: That costs five euros.",
            "payload": {
              "answer": "Das kostet fünf Euro.",
              "accepted": ["Das kostet fünf Euro.", "Das kostet fünf Euro"]
            }
          },
          {
            "type": "mcq",
            "prompt": "\"Sonst noch etwas?\" means…",
            "payload": {
              "options": ["How much is it?", "Anything else?", "Where is the bag?", "Open now?"],
              "answer": "Anything else?"
            }
          }
        ]
      },
      {
