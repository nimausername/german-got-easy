              "answer": "Eine Fahrkarte, bitte."
            }
          },
          {
            "type": "cloze",
            "prompt": "Wo ist die _____? (stop / station stop)",
            "payload": { "answer": "Haltestelle", "accepted": ["Haltestelle"] }
          },
          {
            "type": "speak_prompt",
            "prompt": "Ask for one ticket politely.",
            "payload": {
              "modelText": "Eine Fahrkarte, bitte.",
              "hint": "Short and polite."
