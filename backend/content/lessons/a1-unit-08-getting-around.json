            "title": "Travel survival",
            "items": [
              { "de": "Eine Fahrkarte, bitte.", "en": "One ticket, please." },
              { "de": "Wo ist die Haltestelle?", "en": "Where is the stop?" },
              { "de": "Wann fährt der Bus?", "en": "When does the bus leave?" },
              { "de": "Ich möchte nach …", "en": "I would like to go to …" }
            ]
          },
          {
            "type": "dialogue",
            "title": "At the counter",
            "lines": [
              { "speaker": "You", "de": "Eine Fahrkarte nach Berlin, bitte.", "en": "One ticket to Berlin, please." },
              { "speaker": "Clerk", "de": "Natürlich. Das macht zwanzig Euro.", "en": "Of course. That is twenty euros." },
              { "speaker": "You", "de": "Danke schön.", "en": "Thank you very much." }
            ]
          }
        ],
        "exercises": [
