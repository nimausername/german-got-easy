          },
          {
            "type": "reorder",
            "prompt": "Order: \"When does the bus leave?\"",
            "payload": {
              "tokens": ["Wann", "fährt", "der", "Bus"],
              "answer": ["Wann", "fährt", "der", "Bus"]
            }
          }
        ]
      }
    ]
