[
  {
    "slug": "health",
    "title": "Health basics",
    "description": "Say how you feel and use simple doctor phrases.",
    "lessons": [
      {
        "slug": "how-are-you",
        "title": "How are you?",
        "canDo": "I can say how I feel.",
        "summary": "Mir geht es gut / nicht so gut.",
        "skillTags": ["phrases", "speaking", "listening"],
        "teachBlocks": [
          {
            "type": "explain",
            "title": "Feelings with Mir geht es…",
            "body": "Ask Wie geht es dir? (informal) or Wie geht es Ihnen? (polite). Answer: Mir geht es gut. / Mir geht es nicht so gut. / Ich bin müde.",
            "examples": [
              { "de": "Wie geht es dir?", "en": "How are you?" },
              { "de": "Mir geht es gut, danke.", "en": "I am fine, thanks." }
            ]
          },
          {
            "type": "phrases",
            "title": "Feelings",
            "items": [
              { "de": "müde", "en": "tired" },
              { "de": "krank", "en": "ill / sick" },
              { "de": "gut", "en": "well / good" },
              { "de": "Ich bin müde.", "en": "I am tired." },
              { "de": "Mir ist schlecht.", "en": "I feel sick / nauseous." }
            ]
          },
          {
            "type": "listen_model",
            "title": "Listen",
            "text": "Mir geht es nicht so gut. Ich bin krank.",
            "hint": "nicht so gut = not so well"
          }
        ],
        "exercises": [
          {
            "type": "match",
            "prompt": "Match the feelings",
            "payload": {
              "pairs": [
                { "left": "müde", "right": "tired" },
                { "left": "krank", "right": "ill" },
                { "left": "Mir geht es gut.", "right": "I am fine." },
                { "left": "Wie geht es dir?", "right": "How are you?" }
              ]
            }
          },
          {
            "type": "cloze",
            "prompt": "Mir _____ es gut.",
            "payload": { "answer": "geht", "accepted": ["geht"] }
          },
          {
            "type": "listen_mcq",
            "prompt": "Listen. How does the person feel?",
            "payload": {
              "speakText": "Ich bin müde.",
              "options": ["hungry", "tired", "happy", "cold"],
              "answer": "tired"
            }
          },
          {
            "type": "speak_prompt",
            "prompt": "Answer: How are you?",
            "payload": {
              "modelText": "Mir geht es gut, danke.",
              "hint": "Or: Ich bin müde."
            }
          }
        ]
      },
      {
        "slug": "body-pain",
        "title": "It hurts here",
        "canDo": "I can say a simple pain phrase.",
        "summary": "Kopfschmerzen, Bauchschmerzen, Ich habe …",
        "skillTags": ["vocabulary", "phrases"],
        "teachBlocks": [
          {
            "type": "phrases",
            "title": "Body & pain",
            "items": [
              { "de": "der Kopf", "en": "head" },
