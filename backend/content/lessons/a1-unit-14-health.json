              { "de": "der Hals", "en": "throat / neck" },
              { "de": "Kopfschmerzen", "en": "headache" },
              { "de": "Ich habe Kopfschmerzen.", "en": "I have a headache." },
              { "de": "Es tut weh.", "en": "It hurts." }
            ]
          },
          {
            "type": "pattern",
            "title": "I have … pain",
            "template": "Ich habe ____.",
            "meaning": "I have ____.",
            "examples": ["Ich habe Kopfschmerzen.", "Ich habe Halsschmerzen."]
          }
        ],
        "exercises": [
          {
            "type": "mcq",
            "prompt": "\"Ich habe Kopfschmerzen\" means…",
            "payload": {
              "options": ["I am hungry", "I have a headache", "I am cold", "I need coffee"],
              "answer": "I have a headache"
            }
          },
          {
            "type": "cloze",
            "prompt": "Ich habe _____. (headache)",
            "payload": { "answer": "Kopfschmerzen", "accepted": ["Kopfschmerzen"] }
          },
          {
            "type": "match",
            "prompt": "Match body words",
            "payload": {
              "pairs": [
                { "left": "Kopf", "right": "head" },
                { "left": "Bauch", "right": "stomach" },
                { "left": "Hals", "right": "throat" },
                { "left": "Es tut weh.", "right": "It hurts." }
              ]
            }
          },
          {
            "type": "speak_prompt",
            "prompt": "Say you have a headache.",
            "payload": {
              "modelText": "Ich habe Kopfschmerzen.",
              "hint": "habe + Kopfschmerzen"
            }
          }
        ]
      },
      {
