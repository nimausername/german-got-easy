      {
        "slug": "separable-verbs",
        "title": "Separable verbs",
        "canDo": "I can use simple separable verbs like aufstehen and anrufen.",
        "summary": "Prefix goes to the end in the present: Ich stehe auf.",
        "skillTags": ["grammar", "writing"],
        "teachBlocks": [
          {
            "type": "explain",
            "title": "The little prefix moves",
            "body": "Some verbs split: aufstehen → Ich stehe um sieben Uhr auf. anrufen → Ich rufe dich an. einkaufen → Ich kaufe heute ein. Learn the whole verb, then remember: prefix to the end in present statements.",
            "examples": [
              { "de": "Ich stehe früh auf.", "en": "I get up early." },
              { "de": "Rufst du mich an?", "en": "Are you calling me?" },
              { "de": "Wir kaufen im Supermarkt ein.", "en": "We shop at the supermarket." }
            ]
          },
          {
            "type": "pattern",
            "title": "Split pattern",
            "template": "Ich ____ … ____.",
            "meaning": "stem … prefix",
            "examples": ["Ich stehe … auf.", "Ich rufe … an."]
          }
        ],
        "exercises": [
          {
            "type": "cloze",
            "prompt": "Ich stehe um sieben Uhr _____.",
            "payload": { "answer": "auf", "accepted": ["auf"] }
          },
          {
            "type": "mcq",
            "prompt": "Correct form: Ich ___ dich ___. (anrufen)",
            "payload": {
              "options": [
                "anrufe / —",
                "rufe / an",
                "an / rufe",
                "rufst / anrufen"
              ],
              "answer": "rufe / an"
            }
          },
          {
            "type": "reorder",
            "prompt": "Order: \"I get up early\"",
            "payload": {
              "tokens": ["Ich", "stehe", "früh", "auf"],
              "answer": ["Ich", "stehe", "früh", "auf"]
            }
          },
          {
            "type": "short_write",
            "prompt": "Write: We shop today. (einkaufen)",
            "payload": {
              "answer": "Wir kaufen heute ein.",
              "accepted": ["Wir kaufen heute ein.", "Wir kaufen heute ein"]
            }
          }
        ]
      },
