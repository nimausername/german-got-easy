    "lessons": [
      {
        "slug": "present-regular",
        "title": "Present tense (regular)",
        "canDo": "I can conjugate a regular verb like machen in the present.",
        "summary": "ich mache, du machst, er/sie macht…",
        "skillTags": ["grammar", "writing"],
        "teachBlocks": [
          {
            "type": "explain",
            "title": "Regular verbs follow a clear path",
            "body": "Take the stem (machen → mach-). Add endings: ich -e, du -st, er/sie/es -t, wir -en, ihr -t, sie/Sie -en. Example: ich mache, du machst, er macht, wir machen.",
            "examples": [
              { "de": "Ich mache Frühstück.", "en": "I make breakfast." },
              { "de": "Du lernst Deutsch.", "en": "You learn German." }
            ]
          },
          {
            "type": "pattern",
            "title": "I / you / he",
            "template": "ich ____e / du ____st / er ____t",
            "meaning": "Regular present endings",
            "examples": ["ich wohne / du wohnst / er wohnt"]
          }
        ],
        "exercises": [
          {
            "type": "cloze",
            "prompt": "Ich _____ Deutsch. (lernen)",
            "payload": { "answer": "lerne", "accepted": ["lerne"] }
          },
          {
            "type": "mcq",
            "prompt": "Choose the correct form: Du ___ Kaffee. (trinken)",
            "payload": {
              "options": ["trinke", "trinkst", "trinkt", "trinken"],
              "answer": "trinkst"
            }
          },
          {
            "type": "cloze",
            "prompt": "Sie (she) _____ Musik. (hören)",
            "payload": { "answer": "hört", "accepted": ["hört", "hoert"] }
          },
          {
            "type": "short_write",
            "prompt": "Write: We learn German. (lernen)",
            "payload": {
              "answer": "Wir lernen Deutsch.",
              "accepted": ["Wir lernen Deutsch.", "Wir lernen Deutsch"]
            }
          }
        ]
      },
      {
