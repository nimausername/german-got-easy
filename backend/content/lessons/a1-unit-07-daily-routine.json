                { "left": "arbeiten", "right": "work" },
                { "left": "schlafen", "right": "sleep" },
                { "left": "frühstücken", "right": "have breakfast" }
              ]
            }
          },
          {
            "type": "mcq",
            "prompt": "\"Ich stehe um sieben Uhr auf\" means…",
            "payload": {
              "options": [
                "I sleep at seven",
                "I get up at seven",
                "I eat at seven",
                "I work until seven"
