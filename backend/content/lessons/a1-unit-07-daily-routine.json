              { "speaker": "B", "de": "Ich stehe auf und frühstücke.", "en": "I get up and have breakfast." },
              { "speaker": "B", "de": "Dann gehe ich zur Arbeit.", "en": "Then I go to work." }
            ]
          }
        ],
        "exercises": [
          {
            "type": "match",
            "prompt": "Match the day verbs",
            "payload": {
              "pairs": [
