              "answer": "I get up at seven"
            }
          },
          {
            "type": "reorder",
            "prompt": "Order: \"Then I learn German\"",
            "payload": {
              "tokens": ["Dann", "lerne", "ich", "Deutsch"],
              "answer": ["Dann", "lerne", "ich", "Deutsch"]
            }
          }
        ]
      },
      {
