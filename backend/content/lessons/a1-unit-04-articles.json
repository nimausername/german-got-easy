            "prompt": "Match the objects",
            "payload": {
              "pairs": [
                { "left": "Bett", "right": "bed" },
                { "left": "Handy", "right": "phone" },
                { "left": "Küche", "right": "kitchen" },
                { "left": "Stuhl", "right": "chair" }
              ]
            }
          },
          {
            "type": "listen_mcq",
            "prompt": "Listen. Which object?",
            "payload": {
              "speakText": "das Handy",
              "options": ["table", "phone", "bed", "kitchen"],
              "answer": "phone"
            }
          },
          {
            "type": "speak_prompt",
            "prompt": "Say: That is the bed.",
            "payload": {
              "modelText": "Das ist das Bett.",
              "hint": "das Bett"
            }
          },
          {
            "type": "mcq",
            "prompt": "Which is correct?",
            "payload": {
              "options": ["der Bett", "die Bett", "das Bett", "ein Bettin"],
              "answer": "das Bett"
            }
          }
        ]
      }
    ]
  }
]
