[
  {
    "slug": "greetings",
    "title": "Greetings & introductions",
    "description": "Say hello, introduce yourself, and use sein / heißen.",
    "lessons": [
      {
        "slug": "hello",
        "title": "Hallo & Guten Tag",
        "skillTags": ["vocabulary", "speaking"],
        "exercises": [
          {
            "type": "mcq",
            "prompt": "How do you say \"Good day\" in German?",
            "payload": {
              "options": ["Gute Nacht", "Guten Tag", "Auf Wiedersehen", "Bitte"],
              "answer": "Guten Tag"
            }
          },
          {
            "type": "match",
            "prompt": "Match the greetings",
            "payload": {
              "pairs": [
                { "left": "Hallo", "right": "Hello" },
                { "left": "Guten Morgen", "right": "Good morning" },
                { "left": "Guten Abend", "right": "Good evening" }
              ]
            }
          }
        ]
      },
      {
        "slug": "introduce",
        "title": "Ich heiße…",
        "skillTags": ["grammar", "vocabulary"],
        "exercises": [
          {
            "type": "cloze",
            "prompt": "Complete: Ich _____ Anna.",
            "payload": {
              "answer": "heiße",
              "accepted": ["heiße", "heisse"]
            }
          },
          {
            "type": "mcq",
            "prompt": "What does \"Wie heißt du?\" mean?",
            "payload": {
              "options": ["How old are you?", "What is your name?", "Where do you live?", "How are you?"],
              "answer": "What is your name?"
            }
          }
        ]
      },
      {
        "slug": "sein",
        "title": "Verb: sein (to be)",
        "skillTags": ["grammar"],
        "exercises": [
          {
            "type": "cloze",
            "prompt": "Ich _____ Student.",
            "payload": { "answer": "bin", "accepted": ["bin"] }
          },
          {
            "type": "mcq",
            "prompt": "Choose the correct form: Sie ___ Lehrerin.",
            "payload": {
              "options": ["bist", "bin", "ist", "seid"],
              "answer": "ist"
            }
          },
          {
            "type": "reorder",
            "prompt": "Put the words in order: \"I am from Germany\"",
            "payload": {
              "tokens": ["Ich", "komme", "aus", "Deutschland"],
              "answer": ["Ich", "komme", "aus", "Deutschland"]
            }
          }
        ]
      },
      {
        "slug": "numbers-1-20",
        "title": "Numbers 1–20",
        "skillTags": ["vocabulary"],
        "exercises": [
          {
            "type": "mcq",
            "prompt": "What is \"twelve\" in German?",
            "payload": {
              "options": ["zwanzig", "zwölf", "zwei", "zehn"],
              "answer": "zwölf"
            }
          },
          {
            "type": "cloze",
            "prompt": "Write the number: 7 → _____",
            "payload": { "answer": "sieben", "accepted": ["sieben"] }
          },
          {
            "type": "match",
            "prompt": "Match numbers",
            "payload": {
              "pairs": [
                { "left": "eins", "right": "1" },
                { "left": "fünf", "right": "5" },
                { "left": "zehn", "right": "10" },
                { "left": "zwanzig", "right": "20" }
              ]
            }
          }
        ]
      }
    ]
  }
]
