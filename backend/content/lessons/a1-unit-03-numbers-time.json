      {
        "slug": "clock",
        "title": "Simple clock times",
        "canDo": "I can say full hours like Es ist drei Uhr.",
        "summary": "Es ist … Uhr for full hours.",
        "skillTags": ["phrases", "listening", "speaking"],
        "teachBlocks": [
          {
            "type": "explain",
            "title": "Full hours first",
            "body": "Start with whole hours: Es ist drei Uhr (It is three o'clock). Half past uses halb + next hour: halb vier ≈ 3:30. Keep A1 simple: master Es ist … Uhr first.",
            "examples": [
              { "de": "Es ist zwei Uhr.", "en": "It is two o'clock." },
              { "de": "Es ist zwölf Uhr.", "en": "It is twelve o'clock." }
            ]
          },
          {
            "type": "pattern",
            "title": "Tell the hour",
            "template": "Es ist ____ Uhr.",
            "meaning": "It is ____ o'clock.",
            "examples": ["Es ist eins Uhr.", "Es ist acht Uhr."]
          },
          {
            "type": "listen_model",
            "title": "Listen",
            "text": "Es ist fünf Uhr.",
            "hint": "Repeat after the voice."
          }
        ],
        "exercises": [
          {
            "type": "cloze",
            "prompt": "Es ist drei ____.",
            "payload": { "answer": "Uhr", "accepted": ["Uhr"] }
          },
          {
            "type": "listen_mcq",
            "prompt": "Listen. What time?",
            "payload": {
              "speakText": "Es ist acht Uhr.",
              "options": ["6:00", "7:00", "8:00", "9:00"],
              "answer": "8:00"
            }
          },
          {
            "type": "speak_prompt",
            "prompt": "Say: It is ten o'clock.",
            "payload": {
              "modelText": "Es ist zehn Uhr.",
              "hint": "Es ist + number + Uhr"
            }
          },
          {
            "type": "mcq",
            "prompt": "How do you say 4:00?",
            "payload": {
