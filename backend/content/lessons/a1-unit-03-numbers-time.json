              { "de": "Am Freitag arbeite ich.", "en": "I work on Friday." },
              { "de": "Heute ist Sonntag.", "en": "Today is Sunday." }
            ]
          }
        ],
        "exercises": [
          {
            "type": "match",
            "prompt": "Match the days",
            "payload": {
              "pairs": [
                { "left": "Montag", "right": "Monday" },
                { "left": "Freitag", "right": "Friday" },
                { "left": "Sonntag", "right": "Sunday" },
                { "left": "Mittwoch", "right": "Wednesday" }
              ]
            }
          },
          {
            "type": "cloze",
            "prompt": "___ Montag (on Monday)",
            "payload": { "answer": "Am", "accepted": ["Am", "am"] }
          },
          {
            "type": "mcq",
            "prompt": "What does \"heute\" mean?",
            "payload": {
              "options": ["yesterday", "today", "tomorrow", "evening"],
              "answer": "today"
            }
          }
        ]
