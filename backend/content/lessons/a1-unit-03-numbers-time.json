              { "de": "Mittwoch", "en": "Wednesday" },
              { "de": "Donnerstag", "en": "Thursday" },
              { "de": "Freitag", "en": "Friday" },
              { "de": "Samstag / Sonnabend", "en": "Saturday" },
              { "de": "Sonntag", "en": "Sunday" }
            ]
          },
          {
            "type": "explain",
            "title": "On Monday = am Montag",
            "body": "Use am before a day: am Montag. The weekend is das Wochenende. Today is heute. Tomorrow is morgen.",
