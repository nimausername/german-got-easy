      {
        "slug": "numbers-1-20",
        "title": "Numbers 1–20",
        "canDo": "I can say the numbers from 1 to 20.",
        "summary": "eins, zwei, drei … zwanzig.",
        "skillTags": ["vocabulary", "listening"],
        "teachBlocks": [
          {
            "type": "explain",
            "title": "Count with a steady rhythm",
            "body": "Learn 1–12 first, then 13–20. Notice elf and zwölf are special. From 13, many numbers end with -zehn (dreizehn, vierzehn). Twenty is zwanzig.",
            "examples": [
              { "de": "eins, zwei, drei", "en": "one, two, three" },
              { "de": "fünfzehn, zwanzig", "en": "fifteen, twenty" }
            ]
          },
          {
            "type": "phrases",
            "title": "Key numbers",
            "items": [
              { "de": "eins", "en": "1" },
              { "de": "fünf", "en": "5" },
              { "de": "zehn", "en": "10" },
              { "de": "zwölf", "en": "12" },
              { "de": "fünfzehn", "en": "15" },
              { "de": "zwanzig", "en": "20" }
            ]
          },
          {
            "type": "listen_model",
            "title": "Listen",
            "text": "eins zwei drei vier fünf",
            "hint": "Count along out loud."
          }
        ],
        "exercises": [
          {
            "type": "mcq",
            "prompt": "What is \"twelve\" in German?",
            "payload": {
              "options": ["zwanzig", "zwölf", "zwei", "zehn"],
              "answer": "zwölf"
            }
          },
          {
            "type": "cloze",
            "prompt": "Write the number: 7 → _____",
            "payload": { "answer": "sieben", "accepted": ["sieben"] }
          },
          {
            "type": "match",
            "prompt": "Match numbers",
            "payload": {
              "pairs": [
                { "left": "eins", "right": "1" },
                { "left": "fünf", "right": "5" },
                { "left": "zehn", "right": "10" },
                { "left": "zwanzig", "right": "20" }
              ]
            }
          },
          {
            "type": "listen_mcq",
            "prompt": "Listen. Which number?",
            "payload": {
              "speakText": "fünfzehn",
              "options": ["5", "12", "15", "20"],
              "answer": "15"
            }
          }
        ]
      },
      {
        "slug": "numbers-21-100",
        "title": "Numbers to 100",
        "canDo": "I can read bigger numbers like 21 and 45.",
        "summary": "einundzwanzig: ones before tens.",
        "skillTags": ["vocabulary", "grammar"],
        "teachBlocks": [
          {
            "type": "explain",
            "title": "Ones before tens",
            "body": "From 21, German says the ones first: einundzwanzig = one-and-twenty. Same idea for 45: fünfundvierzig. Learn the tens: dreißig, vierzig, fünfzig, … hundert.",
            "examples": [
              { "de": "einundzwanzig", "en": "21" },
              { "de": "fünfundvierzig", "en": "45" },
              { "de": "hundert", "en": "100" }
            ]
          },
          {
            "type": "pattern",
            "title": "Build a number",
            "template": "____und____",
            "meaning": "ones + und + tens",
            "examples": ["dreiunddreißig", "neunundneunzig"]
          }
        ],
        "exercises": [
          {
            "type": "mcq",
            "prompt": "What is 21 in German?",
            "payload": {
              "options": ["zwanzigeins", "einundzwanzig", "einszwanzig", "zwanzigundeins"],
              "answer": "einundzwanzig"
            }
          },
          {
            "type": "cloze",
            "prompt": "Write 30 in German.",
            "payload": { "answer": "dreißig", "accepted": ["dreißig", "dreissig"] }
          },
          {
            "type": "short_write",
            "prompt": "Write 42 in German.",
            "payload": {
              "answer": "zweiundvierzig",
              "accepted": ["zweiundvierzig"]
            }
          }
        ]
      },
      {
